                 sl->mb_y--;
             }
             eos = get_cabac_terminate(&sl->cabac);
@@ -2692,16 +2707,28 @@ static int decode_slice(struct AVCodecContext *avctx, void *arg)
 
             ret = ff_h264_decode_mb_cavlc(h, sl);
 
-            if (ret >= 0)
-                ff_h264_hl_decode_mb(h, sl);
+            if (ret >= 0) {
+                /* --- coefficient extraction hook (CAVLC, primary MB) ---
+                 * After CAVLC entropy decoding sl->mb[] holds the raw
+                 * quantized transform coefficients.  When extraction is
+                 * active we dump them and skip pixel reconstruction so
+                 * that the decoder terminates as early as possible. */
+                ff_h264_extract_mvs(h, sl);
+                if (!ff_h264_extract_coeffs(h, sl))
+                    ff_h264_hl_decode_mb(h, sl);
+            }
 
             // FIXME optimal? or let mb_decode decode 16x32 ?
             if (ret >= 0 && FRAME_MBAFF(h)) {
                 sl->mb_y++;
                 ret = ff_h264_decode_mb_cavlc(h, sl);
 
-                if (ret >= 0)
-                    ff_h264_hl_decode_mb(h, sl);
+                if (ret >= 0) {
+                    /* --- coefficient extraction hook (CAVLC, MBAFF paired field) --- */
+                    ff_h264_extract_mvs(h, sl);
+                    if (!ff_h264_extract_coeffs(h, sl))
+                        ff_h264_hl_decode_mb(h, sl);
+                }
                 sl->mb_y--;
             }
 
@@ -2847,4 +2874,4 @@ int ff_h264_execute_decode_slices(H264Context *h)
 finish:
     h->nb_slice_ctx_queued = 0;
     return ret;
-}
+}
