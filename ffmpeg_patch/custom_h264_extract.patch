             // FIXME optimal? or let mb_decode decode 16x32 ?
             if (ret >= 0 && FRAME_MBAFF(h)) {
@@ -2630,8 +2641,12 @@ static int decode_slice(struct AVCodecContext *avctx, void *arg)
 
                 ret = ff_h264_decode_mb_cabac(h, sl);
 
-                if (ret >= 0)
-                    ff_h264_hl_decode_mb(h, sl);
+                if (ret >= 0) {
